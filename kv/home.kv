<HomeScreen>:
    name: "home"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.95, 0.95, 0.95, 1
        padding: dp(16)
        spacing: dp(14)

        MDTopAppBar:
            title: ""
            elevation: 0
            md_bg_color: 0.95, 0.95, 0.95, 1
            left_action_items: [["lock-outline", lambda x: None]]
            right_action_items: [["plus-box-outline", lambda x: None], ["menu", lambda x: None]]

        MDBoxLayout:
            size_hint_y: None
            height: dp(90)
            spacing: dp(14)

            FloatLayout:
                size_hint_x: None
                width: dp(72)

                AsyncImage:
                    source: "assets/images/nav.png"
                    size_hint: None, None
                    size: dp(62), dp(62)
                    pos_hint: {"x": 0.0, "center_y": 0.5}
                    allow_stretch: True
                    keep_ratio: True

                MDIconButton:
                    icon: "plus-circle"
                    theme_text_color: "Custom"
                    text_color: 0.18, 0.45, 0.95, 1
                    pos_hint: {"right": 1, "y": 0.0}

            MDBoxLayout:
                orientation: "vertical"
                padding: 0, dp(10), 0, 0

                MDLabel:
                    text: "MIST"
                    font_style: "H4"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0, 0, 0, 1
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "IT Entrepreneur"
                    font_style: "Subtitle1"
                    theme_text_color: "Custom"
                    text_color: 0, 0, 0, 1
                    size_hint_y: None
                    height: self.texture_size[1]

        ScrollView:
            do_scroll_x: False

            MDGridLayout:
                cols: 2
                adaptive_height: True
                spacing: dp(16)
                padding: 0, dp(8), 0, dp(24)

                TileCard:
                    title: "Navigation"
                    icon_text: "navigation-variant-outline"
                    bg_hex: "A97AF7"
                    on_release: app.go_to("navigation")

                TileCard:
                    title: "Chat"
                    icon_text: "chat-outline"
                    bg_hex: "F59B97"
                    on_release: app.go_to("chat")

                TileCard:
                    title: "Reminder"
                    icon_text: "bell-badge-outline"
                    bg_hex: "F2D13D"
                    on_release: app.go_to("reminder")

                TileCard:
                    title: "Task"
                    icon_text: "task"
                    bg_hex: "73C2F0"
                    on_release: app.go_to("task")

                TileCard:
                    title: "Connect to organization"
                    icon_text: "vector-square"
                    bg_hex: "63D39A"
                    on_release: app.go_to("organization")

                TileCard:
                    title: "Settings"
                    icon_text: "cog-outline"
                    bg_hex: "6BD1C8"
                    on_release: app.go_to("settings")