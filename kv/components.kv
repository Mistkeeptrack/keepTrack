<NavItem@ButtonBehavior+AnchorLayout>:
    icon_name: ""
    target_screen: ""

    anchor_x: "center"
    anchor_y: "center"

    on_release: app.go_to(root.target_screen)

    MDIcon:
        icon: root.icon_name
        size_hint: None, None
        size: dp(48), dp(48)

        halign: "center"
        valign: "middle"
        text_size: self.size

        font_size: "30sp"

        theme_text_color: "Custom"
        text_color: 0, 0, 0, 1


<BottomNav@MDGridLayout>:
    cols: 6

    size_hint_y: None
    height: dp(72)

    spacing: 0

    # Equal left and right padding
    padding: dp(8), 0, dp(8), 0

    md_bg_color: 0.96, 0.96, 0.96, 1

    NavItem:
        icon_name: "navigation-variant-outline"
        target_screen: "navigation"

    NavItem:
        icon_name: "chat-outline"
        target_screen: "chat"

    NavItem:
        icon_name: "bell-outline"
        target_screen: "reminder"

    NavItem:
        icon_name: "file-document-multiple-outline"
        target_screen: "tasks"

    NavItem:
        icon_name: "vector-square"
        target_screen: "org"

    NavItem:
        icon_name: "cog-outline"
        target_screen: "settings"