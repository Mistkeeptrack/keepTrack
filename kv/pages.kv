#:import dp kivy.metrics.dp

<DesiredHomeScreen>:
    name: "home"

    MDBoxLayout:
        md_bg_color: 1, 1, 1, 1

        AnchorLayout:
            anchor_x: "center"
            anchor_y: "top"

            MDBoxLayout:
                orientation: "vertical"
                size_hint_x: None
                width: dp(360)
                padding: dp(24)
                spacing: dp(20)

                Widget:
                    size_hint_y: None
                    height: dp(20)

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(80)
                    spacing: dp(16)

                    FitImage:
                        source: "assets/images/mistlogo.jpeg"
                        size_hint: None, None
                        size: dp(64), dp(64)
                        radius: [32, 32, 32, 32]

                    MDBoxLayout:
                        orientation: "vertical"
                        padding: 0, dp(4), 0, 0

                        MDLabel:
                            text: ""
                            bold: True
                            font_style: "H4"
                            theme_text_color: "Custom"
                            text_color: 0, 0, 0, 1
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: ""
                            font_style: "Subtitle1"
                            theme_text_color: "Custom"
                            text_color: 0, 0, 0, 1
                            size_hint_y: None
                            height: self.texture_size[1]

                ScrollView:
                    do_scroll_x: False
                    bar_width: 0

                    MDGridLayout:
                        cols: 2
                        spacing: dp(20)
                        padding: 0, dp(10), 0, dp(30)
                        adaptive_height: True

                        MDCard:
                            size_hint: None, None
                            size: dp(150), dp(150)
                            radius: [18, 18, 18, 18]
                            md_bg_color: 0.66, 0.45, 0.95, 1
                            ripple_behavior: True
                            on_release: app.go_to("navigation")

                            MDBoxLayout:
                                orientation: "vertical"
                                padding: dp(12)
                                spacing: dp(6)

                                Widget:

                                MDIcon:
                                    icon: "navigation-variant-outline"
                                    font_size: "44sp"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(50)

                                MDLabel:
                                    text: "Navigation"
                                    halign: "center"
                                    bold: True
                                    font_style: "Subtitle1"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(32)

                                Widget:

                        MDCard:
                            size_hint: None, None
                            size: dp(150), dp(150)
                            radius: [18, 18, 18, 18]
                            md_bg_color: 0.96, 0.55, 0.55, 1
                            ripple_behavior: True
                            on_release: app.go_to("chat")

                            MDBoxLayout:
                                orientation: "vertical"
                                padding: dp(12)
                                spacing: dp(6)

                                Widget:

                                MDIcon:
                                    icon: "chat-outline"
                                    font_size: "44sp"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(50)

                                MDLabel:
                                    text: "Chat"
                                    halign: "center"
                                    bold: True
                                    font_style: "Subtitle1"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(32)

                                Widget:

                        MDCard:
                            size_hint: None, None
                            size: dp(150), dp(150)
                            radius: [18, 18, 18, 18]
                            md_bg_color: 0.95, 0.80, 0.22, 1
                            ripple_behavior: True
                            on_release: app.go_to("reminder")

                            MDBoxLayout:
                                orientation: "vertical"
                                padding: dp(12)
                                spacing: dp(6)

                                Widget:

                                MDIcon:
                                    icon: "bell-outline"
                                    font_size: "44sp"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(50)

                                MDLabel:
                                    text: "Reminder"
                                    halign: "center"
                                    bold: True
                                    font_style: "Subtitle1"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(32)

                                Widget:

                        MDCard:
                            size_hint: None, None
                            size: dp(150), dp(150)
                            radius: [18, 18, 18, 18]
                            md_bg_color: 0.43, 0.75, 0.93, 1
                            ripple_behavior: True
                            on_release: app.go_to("tasks")

                            MDBoxLayout:
                                orientation: "vertical"
                                padding: dp(12)
                                spacing: dp(6)

                                Widget:

                                MDIcon:
                                    icon: "check-circle-outline"
                                    font_size: "44sp"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(50)

                                MDLabel:
                                    text: "Tasks"
                                    halign: "center"
                                    bold: True
                                    font_style: "Subtitle1"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(40)

                                Widget:

                        MDCard:
                            size_hint: None, None
                            size: dp(150), dp(150)
                            radius: [18, 18, 18, 18]
                            md_bg_color: 0.40, 0.82, 0.58, 1
                            ripple_behavior: True
                            on_release: app.go_to("org")

                            MDBoxLayout:
                                orientation: "vertical"
                                padding: dp(12)
                                spacing: dp(6)

                                Widget:

                                MDIcon:
                                    icon: "vector-square"
                                    font_size: "44sp"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(50)

                                MDLabel:
                                    text: "Discover Services"
                                    halign: "center"
                                    bold: True
                                    font_style: "Subtitle1"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(45)

                                Widget:

                        MDCard:
                            size_hint: None, None
                            size: dp(150), dp(150)
                            radius: [18, 18, 18, 18]
                            md_bg_color: 0.40, 0.80, 0.76, 1
                            ripple_behavior: True
                            on_release: app.go_to("settings")

                            MDBoxLayout:
                                orientation: "vertical"
                                padding: dp(12)
                                spacing: dp(6)

                                Widget:

                                MDIcon:
                                    icon: "cog-outline"
                                    font_size: "44sp"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(50)

                                MDLabel:
                                    text: "Settings"
                                    halign: "center"
                                    bold: True
                                    font_style: "Subtitle1"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(32)

                                Widget:


<NavigationScreen>:
    name: "navigation"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 1, 1, 1, 1

        MDTopAppBar:
            title: "Navigation"
            left_action_items: [["arrow-left", lambda x: app.back_to_home()]]

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(20)

            MDLabel:
                id: compass_label
                text: "Navigation Ready"
                halign: "center"
                font_style: "H4"
                theme_text_color: "Custom"
                text_color: 0, 0, 0, 1

            MDLabel:
                id: location_label
                text: "Tap Start Navigation"
                halign: "center"
                theme_text_color: "Hint"

            MDRaisedButton:
                text: "Start Navigation"
                pos_hint: {"center_x": 0.5}
                on_release: root.start_navigation()

        BottomNav:
<ChatScreen>:
    name: "chat"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 1, 1, 1, 1

        MDTopAppBar:
            title: "Chat"
            left_action_items: [["arrow-left", lambda x: app.back_to_home()]]

        MDTextField:
            id: search_contact
            hint_text: "Search Contact"
            mode: "rectangle"
            size_hint_x: 0.9
            pos_hint: {"center_x": 0.5}

        ScrollView:
            MDList:
                id: contact_list

        MDBoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(10)
            spacing: dp(10)

            MDRaisedButton:
                text: "+ Add to list"
                on_release: root.add_contact()

            MDRaisedButton:
                text: "Delete from list"
                on_release: root.delete_contact()
        
        BottomNav:
<TaskScreen>:
    name: "tasks"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.97, 0.97, 0.97, 1

        MDTopAppBar:
            title: "Notes"
            elevation: 0
            md_bg_color: 0.97, 0.97, 0.97, 1
            specific_text_color: 0, 0, 0, 1

            left_action_items:
                [["arrow-left", lambda x: app.back_to_home()]]

            right_action_items:
                [["plus", lambda x: root.create_note()]]

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(14), dp(8), dp(14), dp(14)
            spacing: dp(10)

            MDTextField:
                id: note_search
                hint_text: "Search notes"
                mode: "rectangle"
                size_hint_y: None
                height: dp(52)
                on_text: root.search_notes(self.text)

            ScrollView:
                do_scroll_x: False

                MDBoxLayout:
                    id: notes_list
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(7)        